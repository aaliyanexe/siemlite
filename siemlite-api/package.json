{
  "name": "siemlite-api",
  "version": "1.0.0",
  "description": "SIEMlite REST API — Security Incident & Event Management",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:schema": "psql %DATABASE_URL% -f db/schema.sql",
    "db:seed": "psql %DATABASE_URL% -f db/seed.sql",
    "db:schema:node": "node scripts/run-sql.js schema.sql",
    "db:seed:node": "node scripts/run-sql.js seed.sql"
  },
  "keywords": ["siem", "soc", "security"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
