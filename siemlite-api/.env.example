# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL 15 — local or Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/siemlite

# JWT (HS256 — minimum 256-bit / 32+ character secret)
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars_long
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Cookies (set Secure=true in production behind HTTPS)
COOKIE_SECURE=false
